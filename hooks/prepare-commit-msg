#!/bin/sh
# prepare-commit-msg hook: append a Model: trailer to every commit message
# (once), so commits carry the mention of the model that produced them.
# Works for new commits, --amend, and merges.

MSG_FILE="$1"
MODEL_LINE="Model: deepseek-v4-flash (DeepSeek Harness)"

if [ -f "$MSG_FILE" ]; then
    if ! grep -q "Model: deepseek-v4-flash" "$MSG_FILE" 2>/dev/null; then
        printf "\n%s\n" "$MODEL_LINE" >> "$MSG_FILE"
    fi
fi
exit 0
